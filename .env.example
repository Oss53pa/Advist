# ============================================
# ADVIST - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ============================================

# ===================
# Supabase (REQUIRED)
# ===================
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===================
# Development Mode
# ===================
# Set to false to use real Supabase instead of mock data
VITE_MOCK_MODE=false

# ===================
# Sentry (Error Tracking)
# ===================
VITE_SENTRY_DSN=https://your-sentry-dsn-here

# ============================================
# EDGE FUNCTION SECRETS (set via supabase CLI)
# ============================================
# These are NOT exposed to the frontend.
# Set them with: supabase secrets set KEY=value
#
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# WHATSAPP_API_TOKEN=...
# WHATSAPP_PHONE_ID=...
