{
  "expo": {
    "name": "Advist",
    "slug": "advist-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "advist",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAEAEA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.advist.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application nécessite l'accès à la caméra pour scanner des documents.",
        "NSPhotoLibraryUsageDescription": "L'application nécessite l'accès à la galerie pour sélectionner des documents.",
        "NSLocationWhenInUseUsageDescription": "L'application utilise votre position pour la signature électronique.",
        "NSFaceIDUsageDescription": "Utilisez Face ID pour vous authentifier."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAEAEA"
      },
      "package": "com.advist.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser $(PRODUCT_NAME) à accéder à votre caméra"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à utiliser votre position"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
